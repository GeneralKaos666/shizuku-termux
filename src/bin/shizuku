#!/data/data/com.termux/files/usr/bin/bash
# shizuku — single CLI of the shizuku-termux core.
# Dispatch by $0: shizuku | shk | rish
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -z "${PREFIX:-}" ]; then
    ST_ROOT="${HOME:-/tmp}/.shizuku-termux-prefix/lib/shizuku-termux"
else
    ST_ROOT="${PREFIX}/lib/shizuku-termux"
fi

# Source tree takes priority (host tests); after install, sources from ST_ROOT.
if [ -f "$SCRIPT_DIR/../lib/paths.sh" ]; then
    LIB_DIR="$SCRIPT_DIR/../lib"
    PLUGIN_DIR="$SCRIPT_DIR/../plugins"
else
    LIB_DIR="$ST_ROOT/lib"
    PLUGIN_DIR="$ST_ROOT/plugins"
fi
# shellcheck source=lib/paths.sh
. "$LIB_DIR/paths.sh"
# shellcheck source=lib/extract-apk.sh
. "$LIB_DIR/extract-apk.sh"
# shellcheck source=lib/doctor.sh
. "$LIB_DIR/doctor.sh"

# Load bridge plugins (always present).
for p in sui wireless keepalive usb-loopback pm-install start-daemon aliases adb-connect; do
    if [ -f "$PLUGIN_DIR/$p.sh" ]; then
        . "$PLUGIN_DIR/$p.sh"
    fi
done

st_usage() {
    cat <<EOF
Usage: shizuku <verb> [args]
Verbs:
  install [--apk <file>|--source latest]
          Extracts Shizuku APK → ${PREFIX:-}/lib/shizuku-termux/
  doctor        Checks core health (dex, app id, uid)
  rish <args>   Passes args to the remote rish launcher
  info          Shizuku version/status
  open          Opens Shizuku app (am start)
  stop          Stops Shizuku
  exec <cmd>    Runs a command via rish
  shell         Interactive shell via rish
  version       CLI version
  uninstall     Removes launcher/dex/symlink (no tinyurl)
  sui           --backend shizuku|sui
  wireless      adb pair/connect IP:port + code
  usb-loopback  adb tcpip 5555 + connect 127.0.0.1:5555
  keepalive     jecis heartbeat (reruns start.sh if rish fails)
  pm-install    pm install via rish only if uid 2000
  start-daemon  Starts Shizuku daemon via adb (official start.sh, fallback libshizuku.so)
  adb-connect   Wireless debugging on 127.0.0.1: port | pair | status | disconnect | wf
  wait          Waits for Shizuku to respond (rish -c true)
  aliases       spm/sam (optional)
  help          This help
EOF
}

st_version() { echo "shizuku-termux fusion 1.0.0"; }

st_install() {
    local dest apk="" source_latest=0
    dest="$(st_prefix_lib)"
    # Parse --apk <file> and --source latest
    while [ $# -gt 0 ]; do
        case "$1" in
            --apk) apk="${2:-}"; shift 2 ;;
            --apk=*) apk="${1#--apk=}"; shift ;;
            --source)
                [ $# -gt 1 ] || { echo "ERROR: --source requires a value" >&2; return 1; }
                shift
                case "$1" in
                    latest) source_latest=1 ;;
                    *) echo "ERROR: unknown source: $1 (use --source latest)" >&2; return 1 ;;
                esac
                shift ;;
            --source=*)
                case "${1#--source=}" in
                    latest) source_latest=1 ;;
                    *) echo "ERROR: unknown source: ${1#--source=} (use --source latest)" >&2; return 1 ;;
                esac
                shift ;;
            *) shift ;;
        esac
    done

    echo "Extracting Shizuku APK to $dest ..."
    if [ -n "$apk" ]; then
        # --apk wins over --source latest
        [ -f "$apk" ] || { echo "ERROR: APK not found: $apk" >&2; return 4; }
        st_extract_from_apk "$apk" "$dest" || return $?
    elif [ "$source_latest" -eq 1 ]; then
        local downloaded_apk
        downloaded_apk="$(mktemp)" || return 1
        st_download_official_apk "$downloaded_apk" || { rm -f "$downloaded_apk"; return 4; }
        st_extract_from_apk "$downloaded_apk" "$dest" || { rm -f "$downloaded_apk"; return $?; }
        rm -f "$downloaded_apk"
    elif command -v pm >/dev/null 2>&1; then
        st_extract_from_pm "$dest" || return $?
    else
        echo "ERROR: neither pm, --apk nor --source latest available (exit 4)" >&2
        return 4
    fi

    # Copy the libs/plugins tree to ST_ROOT so the installed CLI sources from there.
    mkdir -p "$dest/lib" "$dest/plugins"
    cp "$SCRIPT_DIR/../lib/paths.sh" "$SCRIPT_DIR/../lib/extract-apk.sh" "$SCRIPT_DIR/../lib/doctor.sh" "$dest/lib/"
    cp "$SCRIPT_DIR/../plugins/"*.sh "$dest/plugins/"
    cp "$SCRIPT_DIR/../bin/rish.in" "$dest/rish.in"

    # Read chosen backend (sui.sh wrote to $dest/backend). Default: shizuku.
    local loader dex_name
    if [ -f "$dest/backend" ] && [ "$(cat "$dest/backend")" = "sui" ]; then
        loader="rikka.sui.shell.Shell"
        dex_name="rish_sui.dex"
    else
        loader="rikka.shizuku.shell.ShizukuShellLoader"
        dex_name="rish_shizuku.dex"
    fi
    dex="$(st_prefix_lib)/$dex_name"
    lib="$(st_lib_path)"
    app_id="$(st_app_id)"
    [ -f "$dest/rish.in" ] || { echo "ERROR: rish.in not copied" >&2; return 1; }

    sed -e "s|@APP_ID@|$app_id|g" \
        -e "s|@DEX@|$dex|g" \
        -e "s|@LIB@|$lib|g" \
        -e "s|@LOADER@|$loader|g" \
        "$dest/rish.in" > "$dest/rish"
    chmod 755 "$dest/rish"

    # $PREFIX/bin/rish = 3-line wrapper that execs the real one in lib/
    bin_rish="$(st_bin_rish_path)"
    real_rish="$(st_rish_path)"
    mkdir -p "$(dirname "$bin_rish")"
    cat > "$bin_rish" <<WRAPPER
#!/data/data/com.termux/files/usr/bin/bash
exec "$real_rish" "\$@"
WRAPPER
    chmod 755 "$bin_rish"

    # $PREFIX/bin/shizuku and $PREFIX/bin/shk = copy of the CLI (dispatch by $0; sources from ST_ROOT).
    cp "$SCRIPT_DIR/shizuku" "$(st_prefix)/bin/shizuku"
    chmod 755 "$(st_prefix)/bin/shizuku"
    cp "$SCRIPT_DIR/shizuku" "$(st_prefix)/bin/shk"
    chmod 755 "$(st_prefix)/bin/shk"

    echo "OK: installed. rish at $bin_rish (execs $real_rish)"
    echo "OK: tree at $dest (lib/ plugins/)"
    echo "OK: CLI at $(st_prefix)/bin/shizuku and $(st_prefix)/bin/shk"
    return 0
}

st_doctor_cmd() {
    st_doctor
}

st_rish() {
    local rish dex
    rish="$(st_rish_path)"
    dex="$(st_dex_path)"
    [ -f "$rish" ] && [ -f "$dex" ] || { echo "ERROR: launcher/DEX missing (exit 6)" >&2; return 6; }
    [ -w "$dex" ] && { echo "ERROR: DEX writable (exit 3)" >&2; return 3; }
    "$rish" "$@"
}

st_info() { st_rish -c 'pm list packages moe.shizuku.privileged.api' 2>/dev/null || echo "Shizuku did not respond"; }
st_open() { am start moe.shizuku.privileged.api/.MainActivity 2>/dev/null || echo "Could not open via am"; }
st_stop() { am force-stop moe.shizuku.privileged.api 2>/dev/null || true; }
st_exec() { [ $# -gt 0 ] || { echo "ERROR: exec requires a command" >&2; return 1; }; st_rish -c "$*"; }
st_shell() { st_rish -c sh; }

st_uninstall() {
    local dest bin_rish prefix
    dest="$(st_prefix_lib)"
    bin_rish="$(st_bin_rish_path)"
    prefix="$(st_prefix)"
    rm -rf "$dest/lib" "$dest/plugins" "$dest/rish.in" 2>/dev/null || true
    rm -f "$dest/rish" "$dest/rish_shizuku.dex" "$dest/rish_sui.dex" "$dest/librish.so" "$dest/backend" \
          "$bin_rish" "$prefix/bin/shizuku" "$prefix/bin/shk" 2>/dev/null || true
    echo "OK: removed launcher/dex/tree/symlink (no tinyurl)"
    return 0
}

main() {
    local cmd="${1:-}"
    [ -n "$cmd" ] || { st_usage; return 1; }
    shift || true

    # If called as rish, pass straight to the launcher. shk is an alias of the CLI.
    case "$(basename "$0")" in
        rish) st_rish "$cmd" "$@"; return $? ;;
    esac

    case "$cmd" in
        install)   st_install "$@" ;;
        doctor)    st_doctor_cmd "$@" ;;
        rish)      st_rish "$@" ;;
        info)      st_info "$@" ;;
        open)      st_open "$@" ;;
        stop)      st_stop "$@" ;;
        exec)      st_exec "$@" ;;
        shell)     st_shell "$@" ;;
        version)   st_version ;;
        uninstall) st_uninstall "$@" ;;
        sui)       st_plugin_sui "$@" ;;
        wireless)  st_plugin_wireless "$@" ;;
        usb-loopback) st_plugin_usb_loopback "$@" ;;
        keepalive) st_plugin_keepalive "$@" ;;
        pm-install) st_plugin_pm_install "$@" ;;
        start-daemon) st_plugin_start_daemon "$@" ;;
        adb-connect) st_plugin_adb_connect "$@" ;;
        wait)       st_wait "$@" ;;
        aliases)   st_plugin_aliases "$@" ;;
        help|--help|-h) st_usage ;;
        *)         echo "ERROR: unknown verb: $cmd" >&2; st_usage; return 1 ;;
    esac
}

main "$@"
