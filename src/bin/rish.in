#!/system/bin/sh
# rish.in — template do launcher Shizuku (gerado do asset Rikka).
# Placeholders substituídos no generate:
#   @APP_ID@  → RISH_APPLICATION_ID ($TERMUX_APP__PACKAGE_NAME ou com.termux)
#   @DEX@     → caminho absoluto do rish_shizuku.dex
#   @LIB@     → caminho absoluto do librish.so (ou vazio)

APP_ID="@APP_ID@"
DEX="@DEX@"
LIB="@LIB@"
LOADER="@LOADER@"

# Nunca deixar PKG vivo.
if [ "$APP_ID" = "PKG" ] || [ -z "$APP_ID" ]; then
    APP_ID="com.termux"
fi
export RISH_APPLICATION_ID="$APP_ID"

# SDK >= 34: DEX deve ser non-writable. Se gravável → exit 3.
if [ -w "$DEX" ]; then
    echo "ERRO: DEX gravável ($DEX) — app_process aborta no A14" >&2
    exit 3
fi

if [ ! -f "$DEX" ]; then
    echo "ERRO: DEX ausente: $DEX" >&2
    exit 6
fi

if [ -n "$LIB" ] && [ -f "$LIB" ]; then
    export LD_LIBRARY_PATH="$(dirname "$LIB"):${LD_LIBRARY_PATH:-}"
fi

exec /system/bin/app_process -Djava.class.path="$DEX" /system/bin --nice-name=rish "$LOADER" "$@"
