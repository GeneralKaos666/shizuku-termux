#!/system/bin/sh
# rish.in — Shizuku launcher template (generated from the Rikka asset).
# Placeholders substituted at generate time:
#   @APP_ID@  → RISH_APPLICATION_ID ($TERMUX_APP__PACKAGE_NAME or com.termux)
#   @DEX@     → absolute path of rish_shizuku.dex
#   @LIB@     → absolute path of librish.so (or empty)

APP_ID="@APP_ID@"
DEX="@DEX@"
LIB="@LIB@"
LOADER="@LOADER@"

# Never leave PKG alive.
if [ "$APP_ID" = "PKG" ] || [ -z "$APP_ID" ]; then
    APP_ID="com.termux"
fi
export RISH_APPLICATION_ID="$APP_ID"

# SDK >= 34: DEX must be non-writable. If writable → exit 3.
if [ -w "$DEX" ]; then
    echo "ERROR: DEX writable ($DEX) — app_process aborts on A14" >&2
    exit 3
fi

if [ ! -f "$DEX" ]; then
    echo "ERROR: DEX missing: $DEX" >&2
    exit 6
fi

if [ -n "$LIB" ] && [ -f "$LIB" ]; then
    export LD_LIBRARY_PATH="$(dirname "$LIB"):${LD_LIBRARY_PATH:-}"
fi

exec /system/bin/app_process -Djava.class.path="$DEX" /system/bin --nice-name=rish "$LOADER" "$@"
